# Copy this file to .env.local and fill in your own values.
# Supabase: Settings -> API Keys. Never commit .env.local or a secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Gemini: get a free key at https://aistudio.google.com/apikey
# NOTE: this ships inside the app bundle (see src/lib/ai.ts for the tradeoff).
EXPO_PUBLIC_GEMINI_API_KEY=
