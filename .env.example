# Copy this file to .env.local and fill in your own values.
# Supabase: Settings -> API Keys. Never commit .env.local or a secret/service_role key.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional -- Sentry crash reporting. The app runs fine without it; see
# the dsn in Sentry -> Settings -> Client Keys for your project.
EXPO_PUBLIC_SENTRY_DSN=

# The Gemini API key is NOT an app env var anymore -- it's a server-side
# secret on the ai-proxy Edge Function. To set it up on a fresh Supabase
# project: get a free key at https://aistudio.google.com/apikey, then run
#   supabase secrets set GEMINI_API_KEY=your-key-here
#   supabase functions deploy ai-proxy
# See supabase/functions/ai-proxy/index.ts and src/lib/ai.ts.
